{
  "name": "pdf-reader-free",
  "productName": "PDF Gremza",
  "version": "1.15.0",
  "description": "A simple, fast and free PDF viewer",
  "author": "Marsel Preci",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:arm64": "electron-builder --win --arm64",
    "dist:mac": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "al.preci.pdfreaderfree",
    "productName": "PDF Gremza",
    "copyright": "Created by gremza.com open source",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "!**/*.map",
      "!**/*.d.mts",
      "!node_modules/pdfjs-dist/{legacy,image_decoders}/**",
      "!node_modules/pdfjs-dist/build/*.min.mjs",
      "!node_modules/pdfjs-dist/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/webpack.mjs",
      "!node_modules/@napi-rs/**",
      "!node_modules/tesseract.js/{src,docs,scripts}/**",
      "!node_modules/tesseract.js-core/tesseract-core{,-lstm,-simd,-relaxedsimd,-relaxedsimd-lstm}.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core-simd-lstm.{js,wasm}"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "src/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "src/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PDF-Reader-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PDF-Reader-Portable-${version}-${arch}.${ext}"
    }
  }
}
